<script src="{% getBundleFileUrl "js", "defer" %}" type="module"></script>

<!-- Mermaid.js for diagram rendering -->
<style>
  .mermaid {
    background: var(--color-bg-accent);
    border: 1px solid var(--color-bg-accent-2);
    padding: var(--space-s);
    margin: var(--space-m) 0;
    border-radius: var(--border-radius-medium);
    color: var(--color-text);
    text-align: center;
    overflow-x: auto;
  }
  .mermaid svg {
    max-width: none;
    height: auto;
    display: inline-block;
  }
</style>
<script src="https://unpkg.com/mermaid@10/dist/mermaid.min.js"></script>
<script>
  (function () {
    var blocks = [];

    function preferredTheme() {
      var attr = document.documentElement.getAttribute('data-theme');
      if (attr === 'dark') return 'dark';
      if (attr === 'light') return 'default';
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'default';
    }

    function render() {
      if (typeof mermaid === 'undefined' || !blocks.length) return;

      mermaid.initialize({
        startOnLoad: false,
        theme: preferredTheme(),
        securityLevel: 'loose',
        flowchart: {
          useMaxWidth: false,
          htmlLabels: true,
          wrappingWidth: 300
        }
      });

      // Restore the original diagram source, then re-render with the active theme.
      blocks.forEach(function (el) {
        el.removeAttribute('data-processed');
        el.textContent = el.getAttribute('data-mermaid-source');
      });

      mermaid.run({ nodes: blocks, suppressErrors: true });
    }

    function initMermaid() {
      if (typeof mermaid === 'undefined') return;

      document.querySelectorAll('div.mermaid, pre.mermaid').forEach(function (el) {
        if (!el.hasAttribute('data-mermaid-source')) {
          el.setAttribute('data-mermaid-source', el.textContent);
        }
        blocks.push(el);
      });

      render();
    }

    // Run when DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMermaid);
    } else {
      initMermaid();
    }

    // Re-render when the site theme changes (toggle button or system setting).
    new MutationObserver(render).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme']
    });

    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', render);
  })();
</script>
